{
  "name": "thirds-grid",
  "css": "#app{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;padding:1rem;box-sizing:border-box;align-items:start;width:100%;max-width:none}#app>.item{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:.5rem;margin:0;width:100%;max-width:none;min-width:0}#app>.item>.surface{width:100%;max-width:none;min-width:0}#app>.item>.surface>*{width:100%;max-width:none!important;box-sizing:border-box}@media(max-width:900px){#app{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){#app{grid-template-columns:1fr}}",
  "appStyle": {
    "position": "relative",
    "display": "grid",
    "width": "100%",
    "minWidth": "100%",
    "minHeight": "100vh",
    "maxWidth": "none",
    "margin": "0",
    "overflow": "visible"
  },
  "bodyStyle": {
    "overflow": "auto",
    "padding": "0"
  }
}
