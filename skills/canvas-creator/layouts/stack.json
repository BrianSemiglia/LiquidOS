{
  "name": "stack",
  "css": "#app{display:flex;flex-direction:column;gap:.75rem;max-width:980px;margin:0 auto;padding:1rem;box-sizing:border-box;align-items:stretch}#app>.item{position:relative;display:grid;grid-template-columns:minmax(0,1fr);gap:.5rem;margin:0;max-width:100%}#app>.item .surface>*{max-width:100%}",
  "appStyle": {
    "position": "relative",
    "display": "block",
    "width": "100%",
    "height": "auto",
    "minWidth": "100%",
    "minHeight": "100vh",
    "maxWidth": "none",
    "margin": "0",
    "padding": "0",
    "overflow": "visible"
  },
  "bodyStyle": {
    "overflow": "auto",
    "padding": "0"
  }
}
