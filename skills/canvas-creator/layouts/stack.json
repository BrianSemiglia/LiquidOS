{
  "name": "stack",
  "css": "#app{display:flex;flex-direction:column;gap:.75rem;margin:0;padding:1rem;box-sizing:border-box;align-items:flex-start;width:100%;max-width:none}#app>.item{position:relative;display:inline-block;width:auto;max-width:100%;min-width:0;margin:0}#app>.item .component-frame{width:auto;max-width:none;overflow:visible}#app>.item .surface{width:auto;max-width:none;min-width:0;overflow:visible}",
  "appStyle": {
    "position": "relative",
    "display": "block",
    "width": "100%",
    "height": "auto",
    "minWidth": "100%",
    "minHeight": "100vh",
    "maxWidth": "none",
    "margin": "0",
    "padding": "0",
    "overflow": "visible"
  },
  "bodyStyle": {
    "overflow": "auto",
    "padding": "0"
  }
}
