#!/bin/bash
#
# processes — per-component CPU + memory for this workspace's components.
#
# Walks the workspace's process tree, groups descendants by which component
# launched them, sums CPU/mem per component. Only components are reported;
# infrastructure is omitted since you can't fix it from in here.
#
# Usage:
#   processes              # table, sampled over 2s
#   processes --json       # JSON, sampled over 2s
#   processes --sample N   # change sample window (seconds)

set -e

JSON=0
SAMPLE=2
while [ $# -gt 0 ]; do
    case "$1" in
        --json)   JSON=1; shift ;;
        --sample) SAMPLE="$2"; shift 2 ;;
        -h|--help) sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown arg: $1" >&2; exit 2 ;;
    esac
done

if [ -n "$LIQUIDOS_HARNESS_PID" ] && kill -0 "$LIQUIDOS_HARNESS_PID" 2>/dev/null; then
    HARNESS_PID="$LIQUIDOS_HARNESS_PID"
else
    HARNESS_PID=$(pgrep -f 'node server.js --workspace' | head -1)
fi
if [ -z "$HARNESS_PID" ]; then
    echo "no LiquidOS harness running" >&2
    exit 1
fi

# Find each top-level component dispatch — direct children of the
# harness whose command line identifies a component. Two shapes:
#   bash <ws>/components/<name>/start.sh ...     (start.sh-wrapped)
#   <anything> .runtime/<name>-<hex>/...         (direct dispatch)
component_roots() {
    pgrep -P "$HARNESS_PID" | while read -r pid; do
        cmd=$(ps -o command= -p "$pid" 2>/dev/null || true)
        scope=$(echo "$cmd" | sed -nE 's|.*/(components/[^/]+)/start\.sh.*|\1|p')
        if [ -z "$scope" ]; then
            scope=$(echo "$cmd" | sed -nE 's|.*\.runtime/([a-zA-Z0-9_-]+)-[0-9a-f]+/.*|components/\1|p')
        fi
        [ -n "$scope" ] && printf '%s\t%s\n' "$pid" "$scope"
    done
}

# All descendants of a PID, recursively, including itself.
descendants() {
    local root="$1"
    echo "$root"
    for child in $(pgrep -P "$root" 2>/dev/null); do
        descendants "$child"
    done
}

# Build a "<pid> <scope>" line per process so we can attribute each
# sampled row in one pass.
ATTR=$(component_roots | while IFS=$'\t' read -r rootPid scope; do
    for d in $(descendants "$rootPid"); do
        printf '%s %s\n' "$d" "$scope"
    done
done)

if [ -z "$ATTR" ]; then
    if [ "$JSON" -eq 1 ]; then echo '{"components":{}}'; else echo "(no components running)"; fi
    exit 0
fi

PIDLIST=$(echo "$ATTR" | awk '{print $1}' | sort -un | tr '\n' ',' | sed 's/,$//')
PID_ARGS=""
for p in $(echo "$PIDLIST" | tr ',' ' '); do PID_ARGS="$PID_ARGS -pid $p"; done

# Sample 1Hz for SAMPLE+1 iterations; drop the first (zero-baseline) row.
# stats: pid, cpu%, mem (resident, MB-ish via rsize column).
SAMPLES=$(top -l "$((SAMPLE + 1))" -s 1 -o cpu -ncols 4 -stats pid,cpu,mem $PID_ARGS 2>/dev/null \
    | grep -E '^[0-9]+\s')

# Average CPU per PID across samples after the first.
PER_PID=$(echo "$SAMPLES" | awk -v skip="$SAMPLE" '
    {
        seen[$1]++
        if (seen[$1] == 1) next            # skip first sample (baseline)
        cpu[$1] += $2
        n[$1]++
        # mem column on macOS top is e.g. "12M" or "1024K"; convert to MB
        u = substr($3, length($3))
        v = substr($3, 1, length($3)-1) + 0
        if (u == "G") v *= 1024
        else if (u == "K") v /= 1024
        else if (u != "M") v = $3 + 0      # plain number, assume MB
        mem[$1] = v                          # last sample wins for memory
    }
    END { for (p in cpu) printf "%s %.2f %.1f\n", p, cpu[p]/n[p], mem[p] }
')

# Roll up per component.
ROLLUP=$(paste <(echo "$ATTR" | sort -k1) <(echo "$PER_PID" | sort -k1) \
    | awk '$1 == $3 { cpu[$2] += $4; mem[$2] += $5; procs[$2]++ }
           END { for (s in cpu) printf "%s\t%.2f\t%.1f\t%d\n", s, cpu[s], mem[s], procs[s] }' \
    | sort -k2 -n -r)

if [ "$JSON" -eq 1 ]; then
    printf '{"sampleSeconds":%d,"components":{' "$SAMPLE"
    first=1
    while IFS=$'\t' read -r scope cpu mem procs; do
        [ -z "$scope" ] && continue
        if [ "$first" -eq 0 ]; then printf ','; fi
        first=0
        printf '"%s":{"cpuPct":%s,"memMB":%s,"procs":%s}' "$scope" "$cpu" "$mem" "$procs"
    done <<< "$ROLLUP"
    printf '}}\n'
else
    printf '%-40s  %7s  %7s  %5s\n' COMPONENT CPU% MEM_MB PROCS
    while IFS=$'\t' read -r scope cpu mem procs; do
        [ -z "$scope" ] && continue
        printf '%-40s  %6.1f%%  %6.1fM  %5d\n' "$scope" "$cpu" "$mem" "$procs"
    done <<< "$ROLLUP"
fi
