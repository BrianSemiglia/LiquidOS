index.json
# Each probe's sibling .liquidos fixture under skills/testing/scripts must keep
# its index.json so the bundled probes have known-good starting state.
!skills/testing/scripts/**/index.json
node_modules/
package.json
# The Electron wrapper's package.json IS its electron-builder config — keep it tracked.
!electron-app/package.json
package-lock.json
npm-debug.log*
.DS_Store

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
/mac-app/build
/mac-app/.node-cache

# electron-builder output (AppImage/.deb/unpacked)
/electron-app/dist

# Generated build output; PLACEHOLDER is kept so the build works before it runs.
/go-server/clientdist/*
!/go-server/clientdist/PLACEHOLDER
